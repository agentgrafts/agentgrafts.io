{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "AgentGrafts",
  "description": "Portable implementation knowledge for AI agents.",
  "colors": {
    "primary": "#0B0C0E",
    "light": "#FFFFFF",
    "dark": "#0B0C0E"
  },
  "favicon": "/favicon-black.svg",
  "navigation": {
    "languages": [
      {
        "language": "en",
        "default": true,
        "groups": [
          {
            "group": "Start here",
            "pages": ["index", "quickstart", "why-grafts"]
          },
          {
            "group": "The format",
            "pages": ["specification", "lifecycle", "examples/email-otp"]
          },
          {
            "group": "Ecosystem",
            "pages": ["skills-mcp", "roadmap"]
          }
        ]
      },
      {
        "language": "zh",
        "groups": [
          {
            "group": "开始使用",
            "pages": ["zh/index", "zh/quickstart", "zh/why-grafts"]
          },
          {
            "group": "格式规范",
            "pages": ["zh/specification", "zh/lifecycle", "zh/examples/email-otp"]
          },
          {
            "group": "生态系统",
            "pages": ["zh/skills-mcp", "zh/roadmap"]
          }
        ],
        "navbar": {
          "links": [
            { "label": "规范", "href": "/zh/specification" },
            { "label": "GitHub", "href": "https://github.com/agentgrafts/agentgrafts.io" }
          ],
          "primary": {
            "type": "button",
            "label": "快速开始",
            "href": "/zh/quickstart"
          }
        }
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/agentgrafts/agentgrafts.io",
          "icon": "github"
        },
        {
          "anchor": "Agent Skills",
          "href": "https://agentskills.io/home",
          "icon": "sparkles"
        },
        {
          "anchor": "MCP",
          "href": "https://modelcontextprotocol.io/",
          "icon": "plug"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light-logo.png",
    "dark": "/logo/dark-logo.png"
  },
  "navbar": {
    "links": [
      { "label": "Specification", "href": "/specification" },
      { "label": "GitHub", "href": "https://github.com/agentgrafts/agentgrafts.io" }
    ],
    "primary": {
      "type": "button",
      "label": "Read the quickstart",
      "href": "/quickstart"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
